{
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.seed)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials/**)",
      "Read(./**/credentials.json)"
    ]
  }
}
